/**
 * Пример локального конфига AI (не подключать напрямую — только копия).
 *
 * 1. Скопировать: config.local.js.example → config.local.js
 * 2. Вставить ключ с https://openrouter.ai/keys (формат sk-or-v1-...)
 * 3. В HTML подключить config.local.js ПЕРЕД ai-chatbot.js, без defer
 *
 * config.local.js в .gitignore. На GitHub Pages ключ подставляет CI (секрет OPENROUTER_API_KEY).
 */

// Глобальная переменная, которую читает ai-chatbot.js при отправке сообщения
window.DHARMA_OPENROUTER_KEY = 'sk-or-v1-ВАШ_КЛЮЧ';
